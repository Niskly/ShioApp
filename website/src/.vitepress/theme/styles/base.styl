/**
 * Customize default theme styling by overriding CSS variables:
 * https://github.com/vuejs/vitepress/blob/main/src/client/theme-default/styles/vars.css
 */
/**
 * Colors
 * -------------------------------------------------------------------------- */

// Shio theme (same tokens as shios.me)
$themeColor = #7b9cbf

:root {
  --vp-c-brand: $themeColor
  --vp-c-brand-1: $themeColor
  --vp-c-brand-2: #5a7fa8
  --vp-c-brand-3: #4a6d93
  --vp-c-brand-light: tint($themeColor, 20%)
  --vp-c-brand-lighter: tint($themeColor, 40%)
  --vp-c-brand-lightest: tint($themeColor, 60%)
  --vp-c-brand-dark: #5a7fa8
  --vp-c-brand-darker: #4a6d93
  --vp-c-brand-darkest: #3b5878
  --vp-c-brand-dimm: rgba(123, 156, 191, 0.08)
  --vp-c-brand-border: rgba(123, 156, 191, 0.10)
  --vp-c-brand-soft: rgba(123, 156, 191, 0.14)
}

// Dark mode — Shio palette
.dark {
  --vp-c-bg: #0d1520
  --vp-c-bg-alt: #162035
  --vp-c-bg-soft: #162035
  --vp-c-bg-mute: #1e2e48
  --vp-c-divider: rgba(123, 156, 191, 0.10)
  --vp-c-text-2: #c9d6e3
  --vp-sidebar-bg-color: #0d1520
  --vp-nav-bg-color: #0d1520
  --vp-local-nav-bg-color: #0d1520
}

// Rounded corners for content images inserted via HTML (our converted images)

.vp-doc img[loading="lazy"][decoding="async"] {
  border-radius: 2px
}

/**
 * Dark/Light Theme Overrides
 * -------------------------------------------------------------------------- */

html:not(.dark) {
  .only-dark,
  img[data-mode="darkmode-only"] {
    display: none !important

    & + figcaption {
      display: none !important
    }
  }

  figure:has(img[data-mode="darkmode-only"]) {
    display: none !important
  }
}

.dark {
  .only-light,
  img[data-mode="lightmode-only"] {
    display: none !important

    & + figcaption {
      display: none !important
    }
  }

  figure:has(img[data-mode="lightmode-only"]) {
    display: none !important
  }
}

/**
 * Component: Button
 * -------------------------------------------------------------------------- */

:root {
  --vp-button-brand-border: transparent
  --vp-button-brand-text: #ffffff
  --vp-button-brand-bg: #7b9cbf
  --vp-button-brand-hover-border: transparent
  --vp-button-brand-hover-text: #ffffff
  --vp-button-brand-hover-bg: #5a7fa8
  --vp-button-brand-active-border: transparent
  --vp-button-brand-active-text: #ffffff
  --vp-button-brand-active-bg: #4a6d93
}

/**
 * Component: Home
 * -------------------------------------------------------------------------- */

:root {
  --vp-home-hero-name-color: transparent
  --vp-home-hero-name-background: -webkit-linear-gradient(120deg, #7b9cbf 30%, #5a7fa8)
  --vp-home-hero-image-background-image: linear-gradient(-45deg, rgba(123, 156, 191, 0.15) 50%, rgba(90, 127, 168, 0.1) 50%)
  --vp-home-hero-image-filter: blur(20px)
}

.dark {
  --vp-home-hero-image-background-image: linear-gradient(-45deg, rgba(123, 156, 191, 0.12) 25%, rgba(90, 127, 168, 0.08) 25%)
}

@media (min-width 640px) {
  :root {
    --vp-home-hero-image-filter: blur(28px)
  }
}

@media (min-width 960px) {
  :root {
    --vp-home-hero-image-filter: blur(36px)
  }
}

.VPFooter {
  .divider {
    color: var(--vp-c-divider)
  }
}

/**
 * Component: Custom Block
 * -------------------------------------------------------------------------- */

:root {
  --vp-custom-block-tip-border: var(--vp-c-brand)
  --vp-custom-block-tip-text: var(--vp-c-brand-darker)
  --vp-custom-block-tip-bg: var(--vp-c-brand-dimm)
}

.dark {
  --vp-custom-block-tip-border: var(--vp-c-brand)
  --vp-custom-block-tip-text: var(--vp-c-brand-lightest)
  --vp-custom-block-tip-bg: var(--vp-c-brand-dimm)
  --vp-custom-block-info-bg: #212127
}

.plugin-tabs {
  &--content {
    padding: 2rem !important
  }
}

/**
 * Component: Algolia
 * -------------------------------------------------------------------------- */

.DocSearch {
  --docsearch-primary-color: var(--vp-c-brand) !important
}

.VPImage.image-src {
  border-radius: 2px
}

/**
 * Component: LocalSearch
 */

.VPLocalSearchBox {
  --vp-local-search-highlight-bg: var(--vp-c-brand-soft)
  --vp-local-search-highlight-text: var(--vp-c-brand-dark)
}

.dark .VPLocalSearchBox {
  --vp-local-search-highlight-text: var(--vp-c-brand-lightest)
}

/**
 * Component: Image Figure
 * -------------------------------------------------------------------------- */

// Shitty method to give elevation to image - TO BE REPLACED

main figure {
  margin: 2rem 0
  transition: transform var(--vp-tt)

  img {
    margin: 0 auto
    border-radius: 2px
    box-shadow: 2px 2px 8px 4px var(--vp-c-bg-alt)

    &[alt="Translation progress"] {
      box-shadow: none !important
    }
  }

  figcaption {
    text-align: center
    margin-top: 1.25rem
    font-size: 0.875rem
    color: var(--vp-c-text-2)
  }

  & > a .external-link-icon {
    display: none
  }
}

main :where(h1, h2, h3, h4, h5, h6) + figure {
  margin-top: 1.5rem
}

.custom-block {
  figure figcaption {
    color: inherit
  }

  &.tip figure img {
    --vp-c-bg-alt: var(--vp-custom-block-tip-bg)
  }
}

/**
 * Component: Links
 * -------------------------------------------------------------------------- */

@media print {
  figure:has(img)>a[href^="http://"]:after,
  figure:has(img)>a[href^="https://"]:after {
    content: ""
  }
}

.vp-doc a {
  text-decoration: none

  &:hover {
    text-decoration: underline
    text-underline-offset: 2px
  }
}

/**
 * Component: Shortcodes
 * -------------------------------------------------------------------------- */

.navigation {
  color: var(--vp-c-green-2)
  font-weight: 600

  &:hover {
    color: var(--vp-c-green-1)
    cursor: default
  }

  svg,
  span.name {
    vertical-align: middle // Align both SVG and <span> vertically
    position: relative
    bottom: 1px
  }

  svg {
    fill: currentColor
    height: 1em
    width: 1em
    display: inline-block
    margin-right: 4px
  }
}

/**
 * Component: Element Plus
 */

body {
  --el-color-primary: var(--vp-c-brand-1)
}

/**
 * Component: Appearance Switch
 */

.menu + .appearance::before {
  margin-right: 8px !important
}

.appearance + .social-links::before {
  margin-left: 8px !important
}

.VPMenu .CustomSwitchAppearance {
  margin-right: -8px
}

/**
 * Component: Forks page
 */

.forks .VPFeatures {
  padding: 2rem 0 !important

  .VPLink:hover {
    text-decoration: none
  }

  .title {
    line-height: 24px
    font-size: 16px
    font-weight: 600
    margin: 0
    border-top: none
    padding-top: 0
    letter-spacing: 0
    color: var(--vp-c-text-1)
  }
}

@media (min-width 640px) {
  .forks .item.grid-4 {
    width: 50% !important
  }
}

/* Global border-radius override — all UI elements use 5px */
:root {
  --vp-border-radius: 2px
  --el-border-radius-base: 2px
  --el-border-radius-small: 2px
  --el-border-radius-round: 2px
}
.VPButton, .VPNavBar, .VPSidebar, .VPDoc, .VPCard,
.vp-doc div[class*=language-], .custom-block,
.plugin-tabs--tab, input, select, textarea {
}

/* Force 5px on all VitePress buttons — overrides hardcoded component styles */
.VPButton,
.VPButton.medium,
.VPButton.big,
a.VPButton,
button.VPButton {
}
